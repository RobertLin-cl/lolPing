{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lolPing Desktop Pilot",
  "version": "0.1.0",
  "identifier": "com.lolping.desktop-pilot",
  "build": { "frontendDist": "../../out/desktop-pilot/web" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [{
        "identifier": "pilot-overlay",
        "windows": ["overlay-*", "settings"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
      }]
    }
  },
  "bundle": { "active": false, "icon": ["../../build/icon.ico"] }
}
